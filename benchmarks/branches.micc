/* branches.micc -- all six comparison operators and all branch forms
   (ifeq/iflt/if_icmpeq lowerings + goto loop back edges). The
   conditions use cheap '&' masks so the cycles measure the branches,
   not the div/mod runtime. */
int main() {
    int r = 0;
    int i = 0;
    while (i < 2000) {       /* <   */
        if ((i & 1) == 0)     /* ==  */
            r += 1;
        else if ((i & 3) != 0) /* !=  */
            r += 2;
        else
            r += 3;
        if (i > 1000)        /* >   */
            r -= 1;
        if (i >= 1500)       /* >=  */
            r += 1;
        if (i <= 100)        /* <=  */
            r += 1;
        i += 1;
    }
    return r;
}
