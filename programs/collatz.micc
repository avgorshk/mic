/* collatz.micc -- the Collatz conjecture (3n+1 problem).
   For each n: n even -> n/2, n odd -> 3n+1; count steps until n == 1.
   collatz(27) is the classic example: 111 steps, peak value 9232.
   Exercises '%', '/', '*', comparisons, while, if/else and the
   runtime library. Expected result: 111 */

int collatz(int n) {
    int steps = 0;
    while (n != 1) {
        if (n % 2 == 0)
            n = n / 2;
        else
            n = 3 * n + 1;
        steps = steps + 1;
    }
    return steps;
}

int main() {
    int r = collatz(27);
    return r;
}
